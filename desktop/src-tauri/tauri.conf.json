{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zoggyfin",
  "version": "0.1.0",
  "identifier": "com.zogtech.zoggyfin.desktop",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:8082"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Zoggyfin",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Video",
    "shortDescription": "Jellyfin client",
    "longDescription": "Zoggyfin is an open-source client for Jellyfin media servers.",
    "copyright": "Zoggyfin contributors, MPL-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}

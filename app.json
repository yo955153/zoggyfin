{
  "expo": {
    "name": "Zoggyfin",
    "slug": "zoggyfin",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "zoggyfin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zogtech.zoggyfin",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Zoggyfin connects to your Jellyfin server on the local network.",
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zogtech.zoggyfin"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0B0E",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": false,
          "tvosDeploymentTarget": "17.0",
          "androidTVBanner": "./assets/images/tv/android-banner-320x180.png",
          "appleTVImages": {
            "icon": "./assets/images/tv/icon-1280x768.png",
            "iconSmall": "./assets/images/tv/icon-400x240.png",
            "iconSmall2x": "./assets/images/tv/icon-800x480.png",
            "topShelf": "./assets/images/tv/topshelf-1920x720.png",
            "topShelf2x": "./assets/images/tv/topshelf-3840x1440.png",
            "topShelfWide": "./assets/images/tv/topshelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/images/tv/topshelf-wide-4640x1440.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "Zoggyfin",
      "backgroundColor": "#0B0B0E",
      "themeColor": "#0B0B0E"
    }
  }
}

{
  "expo": {
    "name": "Zoggyfin",
    "slug": "zoggyfin",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "zoggyfin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zogtech.zoggyfin",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Zoggyfin connects to your Jellyfin server on the local network and finds nearby devices to watch together.",
        "NSBonjourServices": ["_zgf-together._tcp", "_zgf-together._udp", "_zgf-media._tcp", "_zgf-lan._tcp"],
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "text/plain" }]
        }
      ],
      "package": "com.zogtech.zoggyfin",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0B0E",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": false,
          "tvosDeploymentTarget": "17.0",
          "androidTVBanner": "./assets/images/tv/android-banner-320x180.png",
          "appleTVImages": {
            "icon": "./assets/images/tv/icon-1280x768.png",
            "iconSmall": "./assets/images/tv/icon-400x240.png",
            "iconSmall2x": "./assets/images/tv/icon-800x480.png",
            "topShelf": "./assets/images/tv/topshelf-1920x720.png",
            "topShelf2x": "./assets/images/tv/topshelf-3840x1440.png",
            "topShelfWide": "./assets/images/tv/topshelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/images/tv/topshelf-wide-4640x1440.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "@kesha-antonov/react-native-background-downloader",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zoggyfin reads the name of your Wi-Fi network to choose between the home and the internet address of your server. iOS gives the Wi-Fi name only with location access. Zoggyfin does not use or keep your location."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "Zoggyfin",
      "backgroundColor": "#0B0B0E",
      "themeColor": "#0B0B0E"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d419963f-c3a0-4c69-8653-01ac1df4262e"
      }
    },
    "owner": "admin.zogtech",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d419963f-c3a0-4c69-8653-01ac1df4262e"
    }
  }
}

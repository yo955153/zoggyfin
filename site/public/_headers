# Cloudflare Pages headers. Later rules add to earlier rules for the same header.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; style-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Pages that must always show the newest content.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/download
  Cache-Control: no-cache
/download/*
  Cache-Control: no-cache
/join
  Cache-Control: no-cache
/join/*
  Cache-Control: no-cache

# Images and fonts change rarely; a new file gets a new name.
/img/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Universal links (iOS) and App Links (Android) for invite links (/join).
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: max-age=300
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: max-age=300

{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "10.28.1"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "tv": {
      "extends": "production",
      "channel": "tv",
      "distribution": "internal",
      "env": {
        "EXPO_TV": "1",
        "ZOGGYFIN_TV_SELF_UPDATE": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "tv-play": {
      "extends": "production",
      "env": {
        "EXPO_TV": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6824646949"
      },
      "android": {
        "serviceAccountKeyPath": "../../.config/zoggyfin/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
